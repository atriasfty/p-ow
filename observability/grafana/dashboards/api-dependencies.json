{
  "uid": "pow-api-dependencies",
  "title": "POW API Dependencies",
  "tags": ["pow"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Call volume by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pow-prometheus" },
      "targets": [{ "expr": "sum(rate(pow_api_call_duration_seconds_count[5m])) by (service)", "refId": "A", "legendFormat": "{{service}}", "datasource": { "type": "prometheus", "uid": "pow-prometheus" } }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "p95 latency by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "pow-prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(pow_api_call_duration_seconds_bucket[5m])) by (le, service))", "refId": "A", "legendFormat": "{{service}}", "datasource": { "type": "prometheus", "uid": "pow-prometheus" } }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Error rate by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "pow-prometheus" },
      "targets": [{ "expr": "sum(rate(pow_api_call_errors_total[5m])) by (service)", "refId": "A", "legendFormat": "{{service}}", "datasource": { "type": "prometheus", "uid": "pow-prometheus" } }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "DB query duration (p95) by model.action",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "pow-prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(pow_db_query_duration_seconds_bucket[5m])) by (le, model, action))", "refId": "A", "legendFormat": "{{model}}.{{action}}", "datasource": { "type": "prometheus", "uid": "pow-prometheus" } }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    }
  ]
}
