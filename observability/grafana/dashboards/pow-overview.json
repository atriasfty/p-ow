{
  "uid": "pow-overview",
  "title": "POW Overview",
  "tags": [
    "pow"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Sync Pipeline Health",
      "type": "link",
      "url": "/d/pow-sync-pipeline",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "API Dependencies",
      "type": "link",
      "url": "/d/pow-api-dependencies",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Host Resources",
      "type": "link",
      "url": "/d/pow-host-resources",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Bot Health",
      "type": "link",
      "url": "/d/pow-bot-health",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Node.js Runtime",
      "type": "link",
      "url": "/d/pow-nodejs-runtime",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Alerts",
      "type": "link",
      "url": "/d/pow-alerts",
      "icon": "bell",
      "targetBlank": false
    },
    {
      "title": "Logs Explorer",
      "type": "link",
      "url": "/d/pow-logs-explorer",
      "icon": "doc-box",
      "targetBlank": false
    },
    {
      "title": "Server Health (atria1 & atria2)",
      "type": "link",
      "url": "/d/infra-server-health",
      "icon": "dashboard",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Dashboard (prod)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"pow-dashboard-prod\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Bot (prod)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"pow-bot-prod\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
