      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "wren_process_resident_memory_bytes",
