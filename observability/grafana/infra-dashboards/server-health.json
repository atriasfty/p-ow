{
  "uid": "infra-server-health",
  "title": "Server Health (atria1 & atria2)",
  "description": "General system stats for both physical/VM boxes \u2014 not specific to POW or Wren, both boxes run unrelated tenants too. atria2 scraped locally, atria1 scraped over Tailscale (see prometheus.yml's `node` job). Use the `host` label/legend to tell them apart.",
  "tags": [
    "infra"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Uptime",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "node_time_seconds - node_boot_time_seconds",
          "refId": "A",
          "legendFormat": "{{host}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations"
        },
        "overrides": []
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "CPU cores",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "count(node_cpu_seconds_total{mode=\"idle\"}) by (host)",
          "refId": "A",
          "legendFormat": "{{host}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Load average (5m)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "node_load5",
          "refId": "A",
          "legendFormat": "{{host}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 4,
                "color": "yellow"
              },
              {
                "value": 8,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "CPU usage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) by (host) * 100)",
          "refId": "A",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Load average (1m/5m/15m)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "node_load1",
          "refId": "A",
          "legendFormat": "{{host}} 1m",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        },
        {
          "expr": "node_load5",
          "refId": "B",
          "legendFormat": "{{host}} 5m",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        },
        {
          "expr": "node_load15",
          "refId": "C",
          "legendFormat": "{{host}} 15m",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Memory used",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "refId": "A",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Swap used",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
          "refId": "A",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Disk free (/)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}",
          "refId": "A",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.1,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Disk I/O",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(node_disk_read_bytes_total[5m])) by (host)",
          "refId": "A",
          "legendFormat": "{{host}} read",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        },
        {
          "expr": "sum(rate(node_disk_written_bytes_total[5m])) by (host)",
          "refId": "B",
          "legendFormat": "{{host}} write",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Network I/O",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(node_network_receive_bytes_total{device!=\"lo\"}[5m])) by (device, host)",
          "refId": "A",
          "legendFormat": "{{host}} rx {{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        },
        {
          "expr": "sum(rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m])) by (device, host)",
          "refId": "B",
          "legendFormat": "{{host}} tx {{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Filesystem inode usage (/)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - (node_filesystem_files_free{mountpoint=\"/\"} / node_filesystem_files{mountpoint=\"/\"}))",
          "refId": "A",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "TCP established connections",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "node_netstat_Tcp_CurrEstab",
          "refId": "A",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Running / blocked processes",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "node_procs_running",
          "refId": "A",
          "legendFormat": "{{host}} running",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        },
        {
          "expr": "node_procs_blocked",
          "refId": "B",
          "legendFormat": "{{host}} blocked",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Systemd failed units / fail2ban banned IPs",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "pow_systemd_failed_units",
          "refId": "A",
          "legendFormat": "{{host}} failed units",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        },
        {
          "expr": "sum(pow_fail2ban_banned_ips) by (host, jail)",
          "refId": "B",
          "legendFormat": "{{host}} {{jail}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Tailscale daemon status (1 = Running)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "pow_tailscale_up",
          "refId": "A",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "max": 1,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Docker disk usage by type (total vs reclaimable)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "sum(pow_docker_disk_usage_bytes{kind=\"total\"}) by (host, type)",
          "refId": "A",
          "legendFormat": "{{host}} {{type}} total",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        },
        {
          "expr": "sum(pow_docker_disk_usage_bytes{kind=\"reclaimable\"}) by (host, type)",
          "refId": "B",
          "legendFormat": "{{host}} {{type}} reclaimable",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "Backup freshness (time since last successful backup file)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 60
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pow-prometheus"
      },
      "targets": [
        {
          "expr": "time() - pow_backup_last_file_timestamp_seconds",
          "refId": "A",
          "legendFormat": "{{backup_job}} on {{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pow-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
